{
  "name": "autopool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:clear": "node scripts/clear-dummy-data.mjs",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "contract:compile": "hardhat compile",
    "contract:deploy": "hardhat run scripts/deploy.js --network bsc",
    "contract:deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "web3:activate": "node scripts/activate-web3.js",
    "env:sync": "node scripts/sync-env.js",
    "cron:run": "node scripts/run-cron.js",
    "web3:check": "node scripts/check-web3.mjs",
    "package:hostinger": "node scripts/package-hostinger-zip.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.10",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.54.3",
    "wagmi": "^3.6.21"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.19",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
